# Template for .env — copy to .env and fill in real values. .env is gitignored
# and must never be committed. The loader (scripts/02_load_raw.py) reads these
# via python-dotenv; no credential is ever passed on the command line or hardcoded.
#
#   cp .env.example .env   # then edit .env and set DB_PASSWORD
#
# DB_NAME defaults to `lending`; create that database before running the loader.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=lending
DB_USER=postgres
DB_PASSWORD=
